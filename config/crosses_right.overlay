// Right-hand trackball: overrides for the upstream cb-zmk-keebs listener.

// Ignore trackball motion within 200 ms of the last key press, so typing
// vibration does not flip the Mouse layer on. Raise if it still triggers
// while typing; lower if the layer feels slow to engage after typing.
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    // While the trackball is moving, temporarily activate the Mouse layer
    // (keymap index 3). The layer turns off 500 ms after the last movement
    // or as soon as a key is pressed. The processor refreshes its own timer
    // on every movement, so no per-layer override is needed.
    input-processors
        = <&zip_temp_layer 3 500>
        , <&zip_ble_report_rate_limit>;
};
