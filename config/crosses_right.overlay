// Trackball behaviour. Layer indices (config/crosses.keymap):
//   0 Base, 1 Lower, 2 Raise, 3 Mouse, 4 Extra1, 5-7 Extra2-4
//
// Normal:          left = scroll, right = cursor (+ Mouse layer)
// Layer 4 active:  left = cursor (+ Mouse layer), right = scroll
// Layer 4 is toggled with G on Raise (&tog 4) or held with C (&lt 4 C).

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

/ {
    // Left ball arrives as WHEEL/HWHEEL (converted on the peripheral).
    // In layer 4 this maps it back to REL_Y/REL_X for cursor movement.
    zip_scroll_to_xy_mapper: zip_scroll_to_xy_mapper {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map
            = <INPUT_REL_WHEEL INPUT_REL_Y>
            , <INPUT_REL_HWHEEL INPUT_REL_X>
            ;
    };
};

// Ignore trackball motion within 200 ms of the last key press, so typing
// vibration does not flip the Mouse layer on.
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

// Right trackball (local)
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    input-processors
        = <&zip_temp_layer 3 300>
        , <&zip_ble_report_rate_limit>;

    // Natural scrolling on Y (already inverted by the sensor orientation).
    // Layer 5 (held via `&lt 5 ENTER` on layer 4): back to normal cursor
    // behaviour even while layer 4 is toggled. Must come before the layer 4
    // node: the first matching override wins.
    normal_on_layer5 {
        layers = <5>;
        input-processors
            = <&zip_temp_layer 3 300>
            , <&zip_ble_report_rate_limit>;
    };

    scroll_on_layer4 {
        layers = <4>;
        // Vertical scroll only: X is zeroed before the mapper. Horizontal
        // scrolling is still available via Shift + scroll on the host.
        input-processors
            = <&zip_x_scaler 0 1>
            , <&zip_xy_to_scroll_mapper>
            , <&zip_scroll_scaler 1 4>
            , <&zip_ble_report_rate_limit>;
    };
};

// Left trackball (over the split link). No default processors: outside
// layer 4 this listener behaves exactly like upstream.
&trackball_peripheral_listener {
    // Layer 5: pass the left ball through as scroll (its upstream default),
    // even while layer 4 is toggled. Must come before the layer 4 node.
    normal_on_layer5 {
        layers = <5>;
        input-processors = <&zip_ble_report_rate_limit>;
    };

    cursor_on_layer4 {
        layers = <4>;
        input-processors
            = <&zip_scroll_to_xy_mapper>
            , <&zip_xy_scaler 3 1>
            , <&zip_temp_layer 3 300>;
    };
};
