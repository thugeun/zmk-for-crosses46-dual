// Left-hand trackball. Scroll conversion stays upstream (on the peripheral).
&trackball_peripheral {
    // 400 cpi / upstream scroll scaler 1:2 = 200 effective, same as the
    // right side (800 cpi / 1:4). Raise for faster scrolling.
    cpi = <400>;
    // Regular (mouse-wheel style) scrolling on both axes.
    // y-invert was removed: it made Y natural. x-invert kept as-is.
    x-invert;
};
