// Right-hand trackball: overrides for the upstream cb-zmk-keebs listener.
// Left trackball listener is NOT overridden here (upstream default).

#include <dt-bindings/zmk/input_transform.h>

// Ignore trackball motion within 200 ms of the last key press, so typing
// vibration does not flip the Mouse layer on.
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    // Default: move the cursor and temporarily activate the Mouse layer
    // (keymap index 3) for 500 ms after the last movement.
    input-processors
        = <&zip_temp_layer 3 500>
        , <&zip_ble_report_rate_limit>;

    // Layer 4 (held via `&lt 4 C`, toggled via `&tog 4`): scroll instead of
    // moving. Natural scrolling: Y already arrives inverted from the sensor
    // orientation, so only X is flipped here.
    scroll_on_extra1 {
        layers = <4>;
        input-processors
            = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>
            , <&zip_xy_to_scroll_mapper>
            , <&zip_scroll_scaler 1 4>
            , <&zip_ble_report_rate_limit>;
    };
};
