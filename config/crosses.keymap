#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_54_layout; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE  &kp N1  &kp N2  &kp N3  &kp N4        &kp N5        &kp N6  &kp N7     &kp N8           &kp N9   &kp N0    &kp BSPC
&lt 4 TAB   &kp Q   &kp W   &kp E   &kp R         &kp T         &kp Y   &kp U      &kp I            &kp O    &kp P     &kp DEL
&kp LCTRL   &kp A   &kp S   &kp D   &kp F         &kp G         &kp H   &kp J      &kp K            &kp L    &kp SEMI  &kp RET
&kp LSHFT   &kp Z   &kp X   &kp C   &kp V         &kp B         &kp N   &kp M      &kp COMMA        &kp DOT  &kp FSLH  &kp RSHFT
                            &mo 3   &kp LEFT_GUI  &kp LEFT_ALT  &mo 2   &kp SPACE  &lt 1 RIGHT_ALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp ESC           &kp F1  &kp F2    &kp F3    &kp F4     &kp F5         &kp F6  &kp F7    &kp F8    &kp F9     &kp F10  &kp F11
&kp TAB           &trans  &trans    &kp UP    &trans     &kp BACKSPACE  &trans  &trans    &kp UP    &trans     &trans   &kp DEL
&kp LEFT_CONTROL  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DELETE     &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &kp SQT
&kp LSHFT         &trans  &trans    &trans    &trans     &trans         &trans  &trans    &trans    &trans     &trans   &trans
                                    &trans    &trans     &trans         &trans  &trans    &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TILDE  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5     &kp N6     &kp N7     &kp N8           &kp N9    &kp N0    &kp GRAVE
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &tog 4     &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp APOS
&kp LSHFT  &trans    &trans  &trans    &trans    &to 0      &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp DOUBLE_QUOTES
                             &mo 0     &kp LALT  &kp SPACE  &trans     &trans     &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans  &trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &studio_unlock
&trans  &trans     &trans     &trans     &trans     &trans  &trans          &trans        &trans        &trans        &trans  &trans
&trans  &trans     &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans  &trans          &mkp LCLK     &mkp MCLK     &mkp RCLK     &trans  &trans
&trans  &kp LC(Z)  &mkp MB4   &trans     &mkp MB5   &trans  &studio_unlock  &mkp MB4      &mkp MB5      &trans        &trans  &bt BT_CLR
                              &trans     &trans     &trans  &trans          &trans        &trans
            >;
        };

        rt_scroll {
            display-name = "rt_scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &lt 5 RET
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        temp_base {
            display-name = "for_layer_4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
