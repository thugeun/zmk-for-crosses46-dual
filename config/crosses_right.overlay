// Trackball behaviour, both halves. Layer indices (config/crosses.keymap):
//   0 Base, 1 Lower, 2 Raise, 3 Mouse, 4 Extra1 (swap mode), 5-7 Extra2-4
//
// Normal:            left = scroll, right = cursor (+ Mouse layer)
// Layer 4 active:    left = cursor (+ Mouse layer), right = scroll
// Layer 4 is toggled with G on Raise (&tog 4) or held with C (&lt 4 C).
//
// The left half is left exactly as upstream ships it: it converts XY to
// scroll on the peripheral and sends WHEEL/HWHEEL. In swap mode the central
// maps those back to REL_X/REL_Y so the left ball drives the cursor.

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    zip_scroll_to_xy_mapper: zip_scroll_to_xy_mapper {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map
            = <INPUT_REL_WHEEL INPUT_REL_Y>
            , <INPUT_REL_HWHEEL INPUT_REL_X>
            ;
    };
};

// Ignore trackball motion within 200 ms of the last key press, so typing
// vibration does not flip the Mouse layer on.
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

// Right trackball (local)
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    input-processors
        = <&zip_temp_layer 3 500>
        , <&zip_ble_report_rate_limit>;

    scroll_on_swap {
        layers = <4>;
        input-processors
            = <&zip_xy_to_scroll_mapper>
            , <&zip_scroll_scaler 1 4>
            , <&zip_ble_report_rate_limit>;
    };
};

// Left trackball (arrives as scroll events over the split link)
&trackball_peripheral_listener {
    status = "okay";
    device = <&trackball_peripheral_split>;

    cursor_on_swap {
        layers = <4>;
        input-processors
            = <&zip_scroll_to_xy_mapper>
            , <&zip_xy_scaler 2 1>
            , <&zip_temp_layer 3 500>;
    };
};
